# Copy this file to backend/.env for local backend development.
# Keep real passwords and secrets out of .env.example.

# The backend defaults to backend/campus_nexus.db. Set an SQLite URL only when
# a different database file is needed.
# DATABASE_URL=sqlite:///D:/data/campus_nexus.db
# Direct connection for a local standalone server. Use the provider's
# neo4j+s:// URI for Aura or a routed cluster.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
NEO4J_DATABASE=neo4j

# Backend server settings.
PORT=5000
FLASK_DEBUG=1
CORS_ORIGIN=http://localhost:3000

# Use a unique random value of at least 32 characters outside local development.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_HOURS=24
JWT_COOKIE_SECURE=0
ALLOWED_EMAIL_DOMAINS=example.edu,campus.example
